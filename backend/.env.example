# Server
SERVER_PORT=8081
ADMIN_PORT=3000
GATEWAY_PORT=8080
SERVER_ENV=development

# Super admin sign-in (replace the example password before shared/deployed use)
AUTH_EMAIL=superadmin@snakerule.cn
AUTH_NAME=SuperAdmin
AUTH_PASSWORD=change-this-before-run
AUTH_SESSION_TTL=24h

# Pulse product license. Keep the encryption key private and stable across restarts.
LICENSE_STORE_PATH=./data/license.json
LICENSE_ENCRYPTION_KEY=
PULSE_PRODUCT_PUBLIC_KEY=

# Database
DATABASE_URL=postgres://snakerule:snakerule_dev@localhost:5432/snakerule?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5

# Redis
REDIS_URL=redis://localhost:6379/0

# Jev AI
JEV_API_URL=https://api.jev.so/v1
JEV_API_KEY=your-jev-api-key-here
JEV_DEFAULT_MODEL=jev-v1
JEV_DEFAULT_TIMEOUT_MS=200

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# Log
LOG_LEVEL=debug
LOG_FORMAT=json
