# Server
SERVER_PORT=8081
ADMIN_PORT=3000
GATEWAY_PORT=8080
SERVER_ENV=development

# Super admin sign-in (replace the example password before shared/deployed use)
AUTH_EMAIL=superadmin@snakerule.cn
AUTH_NAME=SuperAdmin
AUTH_PASSWORD=change-this-before-run
AUTH_SESSION_TTL=24h

# Pulse product license. Keep the encryption key private and stable across restarts.
LICENSE_ENCRYPTION_KEY=
PULSE_PRODUCT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAmnKAHnmATr2/YbdsVqzI\nO9tYCuR06FsDawH66qsVUa7qay5FibbsX9S+4g0acKvhBSO09rjCeeeOE6VywkNj\ndgZY2FgkbOeFkRO4R2KWp5uxVwzxFR7ywIEAOt04aPcvdGvlAP6yOYTLPnPk9Qbr\nIzANbyIOdSmrM5D9DEdhzrV1NnmhLsVrdD60WgFa/52no4LlHawDwJAki+ZELlzR\nq2e9my8gQ/CiODk7txDcAzBUY6FHDA9l7j/LyC4glGHN+12D7wbt45fdTRlpzzR1\nY2BYtcpucoW6bRzbUaI+HbntwWfdOViQ/SaQlljLioyYKG1GCa4QaosJBwfEL1Mn\n5QIDAQAB\n-----END PUBLIC KEY-----"
PULSE_HEARTBEAT_URL=https://pulse.szplanner.com/api/v1/snakerule/v1/telemetry/heartbeat
PULSE_HEARTBEAT_INTERVAL_SECONDS=240
PULSE_HEARTBEAT_TIMEOUT_SECONDS=30

# Database
DATABASE_URL=postgres://snakerule:snakerule_dev@localhost:5432/snakerule?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5

# Redis
REDIS_URL=redis://localhost:6379/0

# Jev AI
JEV_API_URL=https://api.jev.so/v1
JEV_API_KEY=your-jev-api-key-here
JEV_DEFAULT_MODEL=jev-v1
JEV_DEFAULT_TIMEOUT_MS=200

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# Log
LOG_LEVEL=debug
LOG_FORMAT=json

# Invocation log retention. Set INVOCATIONS_RETENTION_DAYS=0 to disable deletion.
INVOCATIONS_RETENTION_DAYS=30
INVOCATIONS_CLEANUP_INTERVAL_SECONDS=3600
INVOCATIONS_CLEANUP_BATCH_SIZE=500
