{
  "openapi": "3.1.0",
  "info": {
    "title": "SnakeRule API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Session ended"
          }
        }
      }
    },
    "/api/v1/platform/license": {
      "get": {
        "operationId": "getLicense",
        "responses": {
          "200": {
            "description": "Current license status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicenseStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "uploadLicense",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "License validated and stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicenseStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid license"
          }
        }
      },
      "delete": {
        "operationId": "clearLicense",
        "responses": {
          "200": {
            "description": "License cleared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicenseStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rulesets": {
      "get": {
        "operationId": "listRulesets",
        "responses": {
          "200": {
            "description": "Rulesets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RulesetList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createRuleset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ruleset"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved ruleset"
          }
        }
      }
    },
    "/api/v1/rulesets/{id}": {
      "get": {
        "operationId": "getRuleset",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ruleset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ruleset"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateRuleset",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ruleset"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved ruleset"
          }
        }
      },
      "delete": {
        "operationId": "deleteRuleset",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/v1/engine/evaluate": {
      "post": {
        "operationId": "evaluate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "responses": {
          "200": {
            "description": "Workspaces and current selection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createWorkspace",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workspace created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/active": {
      "put": {
        "operationId": "setActiveWorkspace",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveWorkspaceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active workspace changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveWorkspaceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{id}": {
      "put": {
        "operationId": "updateWorkspace",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workspace updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteWorkspace",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Workspace deleted"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SessionUser": {
        "type": "object",
        "required": [
          "email",
          "name",
          "is_superadmin"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "is_superadmin": {
            "type": "boolean"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "authenticated"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        }
      },
      "LicenseStatus": {
        "type": "object",
        "required": [
          "configured",
          "edition",
          "is_licensed",
          "installation_id"
        ],
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "edition": {
            "type": "string"
          },
          "is_licensed": {
            "type": "boolean"
          },
          "customer": {
            "type": "string"
          },
          "license_type": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "features": {
            "type": "object",
            "additionalProperties": true
          },
          "feature_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "installation_id": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Action": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Condition": {
        "type": "object",
        "properties": {
          "all": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Condition"
            }
          },
          "any": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Condition"
            }
          },
          "not": {
            "$ref": "#/components/schemas/Condition"
          },
          "fact": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "value": {}
        }
      },
      "Rule": {
        "type": "object",
        "required": [
          "id",
          "name",
          "priority",
          "enabled",
          "conditions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          },
          "conditions": {
            "$ref": "#/components/schemas/Condition"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          }
        }
      },
      "Ruleset": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "enabled",
          "rules"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rule"
            }
          }
        }
      },
      "RulesetList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ruleset"
            }
          }
        }
      },
      "EvaluateRequest": {
        "type": "object",
        "required": [
          "rulesetId",
          "facts"
        ],
        "properties": {
          "rulesetId": {
            "type": "string"
          },
          "facts": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "MatchedRule": {
        "type": "object",
        "required": [
          "ruleId",
          "name",
          "priority"
        ],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          }
        }
      },
      "Decision": {
        "type": "object",
        "required": [
          "rulesetId",
          "version",
          "matched",
          "hitRules"
        ],
        "properties": {
          "rulesetId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "matched": {
            "type": "boolean"
          },
          "hitRules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchedRule"
            }
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "WorkspaceList": {
        "type": "object",
        "required": [
          "items",
          "active_workspace_id"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            }
          },
          "active_workspace_id": {
            "type": "string"
          }
        }
      },
      "WorkspaceInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ActiveWorkspaceRequest": {
        "type": "object",
        "required": [
          "workspace_id"
        ],
        "properties": {
          "workspace_id": {
            "type": "string"
          }
        }
      },
      "ActiveWorkspaceResponse": {
        "type": "object",
        "required": [
          "active_workspace_id"
        ],
        "properties": {
          "active_workspace_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
