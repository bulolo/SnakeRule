{
  "openapi": "3.1.0",
  "info": {
    "title": "SnakeRule API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Session ended"
          }
        }
      }
    },
    "/api/v1/platform/license": {
      "get": {
        "operationId": "getLicense",
        "responses": {
          "200": {
            "description": "Current license status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicenseStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "uploadLicense",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "License validated and stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicenseStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid license"
          }
        }
      },
      "delete": {
        "operationId": "clearLicense",
        "responses": {
          "200": {
            "description": "License cleared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicenseStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rulesets": {
      "get": {
        "operationId": "listRulesets",
        "responses": {
          "200": {
            "description": "Rulesets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RulesetList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createRuleset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ruleset"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved ruleset"
          }
        }
      }
    },
    "/api/v1/rulesets/{id}": {
      "get": {
        "operationId": "getRuleset",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ruleset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ruleset"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateRuleset",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ruleset"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved ruleset"
          }
        }
      },
      "delete": {
        "operationId": "deleteRuleset",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/v1/engine/evaluate": {
      "post": {
        "operationId": "evaluate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/alert-channels": {
      "get": {
        "operationId": "listAlertChannels",
        "responses": {
          "200": {
            "description": "Alert channels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AlertChannel"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAlertChannel",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertChannelInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Alert channel created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertChannel"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/alert-channels/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "operationId": "updateAlertChannel",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertChannelInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Alert channel updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertChannel"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteAlertChannel",
        "responses": {
          "204": {
            "description": "Alert channel deleted"
          }
        }
      }
    },
    "/api/v1/system/alert-channels/{id}/test": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "testAlertChannel",
        "responses": {
          "200": {
            "description": "Test notification sent"
          }
        }
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "responses": {
          "200": {
            "description": "Workspaces and current selection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createWorkspace",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workspace created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/active": {
      "put": {
        "operationId": "setActiveWorkspace",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveWorkspaceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active workspace changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveWorkspaceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{id}": {
      "put": {
        "operationId": "updateWorkspace",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workspace updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteWorkspace",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Workspace deleted"
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "listProjects",
        "responses": {
          "200": {
            "description": "Projects in current workspace",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    },
                    "active_project_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/active": {
      "put": {
        "operationId": "setActiveProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveProjectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active project changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveProjectResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "operationId": "updateProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteProject",
        "responses": {
          "204": {
            "description": "Project and its rules deleted"
          }
        }
      }
    },
    "/api/v1/projects/{id}/api-keys": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "listProjectKeys",
        "responses": {
          "200": {
            "description": "Project API keys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProjectKey"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createProjectKey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectKeyInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "API key secret or JWT token is returned once and cannot be retrieved later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "item": {
                      "$ref": "#/components/schemas/ProjectKey"
                    },
                    "secret": {
                      "type": "string",
                      "description": "API key returned only when type is apikey."
                    },
                    "token": {
                      "type": "string",
                      "description": "JWT returned only when type is jwt."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{id}/api-keys/{keyID}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "keyID",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "delete": {
        "operationId": "deleteProjectKey",
        "responses": {
          "204": {
            "description": "Project API key revoked"
          }
        }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "operationId": "listNotifications",
        "responses": {
          "200": {
            "description": "Notifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Notification"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/read-all": {
      "post": {
        "operationId": "readAllNotifications",
        "responses": {
          "200": {
            "description": "All notifications marked as read"
          }
        }
      }
    },
    "/api/v1/notifications/{id}/read": {
      "post": {
        "operationId": "readNotification",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Notification marked as read"
          }
        }
      }
    },
    "/api/v1/projects/{id}/invocations": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "listProjectInvocations",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "is_pager",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 1,
              "description": "0 returns all retained items; 1 enables pagination."
            }
          },
          {
            "name": "ruleset_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent invocation logs for a project, optionally filtered by ruleset; bounded request and response previews are included.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvocationListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SessionUser": {
        "type": "object",
        "required": [
          "email",
          "name",
          "is_superadmin"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "is_superadmin": {
            "type": "boolean"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "authenticated"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        }
      },
      "LicenseStatus": {
        "type": "object",
        "required": [
          "configured",
          "edition",
          "is_licensed",
          "installation_id"
        ],
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "edition": {
            "type": "string"
          },
          "is_licensed": {
            "type": "boolean"
          },
          "customer": {
            "type": "string"
          },
          "license_type": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "features": {
            "type": "object",
            "additionalProperties": true
          },
          "feature_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "installation_id": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Action": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Condition": {
        "type": "object",
        "properties": {
          "all": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Condition"
            }
          },
          "any": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Condition"
            }
          },
          "not": {
            "$ref": "#/components/schemas/Condition"
          },
          "fact": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "value": {}
        }
      },
      "Rule": {
        "type": "object",
        "required": [
          "id",
          "name",
          "priority",
          "enabled",
          "conditions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          },
          "conditions": {
            "$ref": "#/components/schemas/Condition"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          },
          "alert": {
            "$ref": "#/components/schemas/RuleAlert"
          }
        }
      },
      "Ruleset": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "enabled",
          "rules"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "alert": {
            "$ref": "#/components/schemas/RuleAlert"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rule"
            }
          }
        }
      },
      "RulesetList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ruleset"
            }
          }
        }
      },
      "EvaluateRequest": {
        "type": "object",
        "required": [
          "rulesetId",
          "facts"
        ],
        "properties": {
          "rulesetId": {
            "type": "string"
          },
          "facts": {
            "type": "object",
            "additionalProperties": true
          },
          "ruleset": {
            "$ref": "#/components/schemas/Ruleset"
          }
        }
      },
      "MatchedRule": {
        "type": "object",
        "required": [
          "ruleId",
          "name",
          "priority"
        ],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          }
        }
      },
      "Decision": {
        "type": "object",
        "required": [
          "rulesetId",
          "version",
