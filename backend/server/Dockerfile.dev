FROM golang:1.24-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/snakerule-server ./cmd/main

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 10001 snakerule \
    && adduser -S -D -H -u 10001 -G snakerule snakerule
WORKDIR /app
COPY --from=builder --chown=10001:10001 /out/snakerule-server /app/snakerule-server
USER 10001:10001
ENV SERVER_PORT=8081
EXPOSE 8081
ENTRYPOINT ["/app/snakerule-server"]
